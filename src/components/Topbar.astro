---
const { user } = Astro.locals;
---

<div class="pixel-panel mb-4 flex items-center justify-between px-4 py-2 text-sm">
  {user ? (
    <>
      <span class="text-muted-foreground">{user.email}</span>
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="text-primary transition-colors hover:text-accent hover:underline">
          Panel
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-primary transition-colors hover:text-accent hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Niezalogowany</span>
      <div class="flex gap-4">
        <a href="/auth/signin" class="text-primary transition-colors hover:text-accent hover:underline">
          Zaloguj
        </a>
        <a href="/auth/signup" class="text-primary transition-colors hover:text-accent hover:underline">
          Rejestracja
        </a>
      </div>
    </>
  )}
</div>
