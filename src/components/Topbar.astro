---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  return pathname === href;
}

const linkClass = (href: string) =>
  cn(
    "text-primary transition-colors hover:text-accent hover:underline",
    isActive(href) && "underline text-accent",
  );
---

<div class="pixel-panel mb-4 flex flex-wrap items-center justify-between gap-3 px-4 py-2 text-sm">
  <a href="/" class="font-pixel text-pixel-sm shrink-0 uppercase tracking-wide text-foreground hover:text-primary">
    Panel Ekspertów
  </a>
  {user ? (
    <div class="flex flex-wrap items-center gap-4">
      <span class="text-muted-foreground block max-w-40 truncate sm:max-w-60" title={user.email}>
        {user.email}
      </span>
      <a href="/dashboard" class={linkClass("/dashboard")} aria-current={isActive("/dashboard") ? "page" : undefined}>
        Panel
      </a>
      <a href="/sessions/new" class={linkClass("/sessions/new")} aria-current={isActive("/sessions/new") ? "page" : undefined}>
        Nowa decyzja
      </a>
      <a href="/sessions" class={linkClass("/sessions")} aria-current={isActive("/sessions") ? "page" : undefined}>
        Historia
      </a>
      <form method="POST" action="/api/auth/signout">
        <button type="submit" class={cn(buttonVariants({ variant: "link" }), "text-primary")}>Wyloguj</button>
      </form>
    </div>
  ) : (
    <div class="flex flex-wrap items-center gap-4">
      <span class="text-muted-foreground">Niezalogowany</span>
      <a href="/auth/signin" class={linkClass("/auth/signin")} aria-current={isActive("/auth/signin") ? "page" : undefined}>
        Zaloguj
      </a>
      <a href="/auth/signup" class={linkClass("/auth/signup")} aria-current={isActive("/auth/signup") ? "page" : undefined}>
        Rejestracja
      </a>
    </div>
  )}
</div>
