---
import Topbar from "@/components/Topbar.astro";

// 12×12 pixel-art avatar placeholders — swap for real sprites later.
// Legend: V primary (violet), D chart-3 (dark violet), C accent (cyan),
// W foreground (light), B background (dark), . transparent
const PIXEL_FILL: Record<string, string> = {
  V: "var(--primary)",
  D: "var(--chart-3)",
  C: "var(--accent)",
  W: "var(--foreground)",
  B: "var(--background)",
};

interface Advisor {
  name: string;
  role: string;
  score: number;
  grid: string[];
}

const advisors: Advisor[] = [
  {
    name: "WIZJONER",
    role: "Widzi szanse, zanim staną się oczywiste",
    score: 8,
    grid: [
      "....CC......",
      "....CC......",
      "..VVVVVVVV..",
      ".VVVVVVVVVV.",
      ".VVWWVVWWVV.",
      ".VVWCVVCWVV.",
      ".VVVVVVVVVV.",
      ".VVVVVVVVVV.",
      ".VVBVVVVBVV.",
      ".VVVBBBBVVV.",
      "..VVVVVVVV..",
      "...V....V...",
    ],
  },
  {
    name: "SCEPTYK",
    role: "Znajdzie dziurę w każdym planie",
    score: 4,
    grid: [
      "............",
      "..DDDDDDDD..",
      ".DDDDDDDDDD.",
      ".DDWWDDWWDD.",
      ".DDWCDDCWDD.",
      ".DDDDDDDDDD.",
      ".DDDDDDDDDD.",
      ".DDBBBBBBDD.",
      ".DDDDDDDDDD.",
      "..DDDDDDDD..",
      "...D....D...",
      "............",
    ],
  },
  {
    name: "ANALITYK",
    role: "Liczby przed opiniami",
    score: 7,
    grid: [
      "............",
      "..VVVVVVVV..",
      ".VVVVVVVVVV.",
      ".CCCCVVCCCC.",
      ".CWWCVVCWWC.",
      ".CCCCVVCCCC.",
      ".VVVVVVVVVV.",
      ".VVVVVVVVVV.",
      ".VVVBBBBVVV.",
      "..VVVVVVVV..",
      "...V....V...",
      "............",
    ],
  },
  {
    name: "PRAGMATYK",
    role: "Co da się zrobić do piątku?",
    score: 6,
    grid: [
      "............",
      "..WWWWWWWW..",
      "..WWWWWWWW..",
      ".VVVVVVVVVV.",
      ".VVWCVVCWVV.",
      ".VVVVVVVVVV.",
      ".VVVVVVVVVV.",
      ".VVVBBBBVVV.",
      ".VVVVVVVVVV.",
      "..VVVVVVVV..",
      "...V....V...",
      "............",
    ],
  },
];

const steps = [
  {
    nr: "01",
    title: "Wrzuć problem",
    desc: "Opisz decyzję, z którą się mierzysz — jedno pytanie, tyle kontekstu, ile chcesz.",
  },
  {
    nr: "02",
    title: "Eksperci debatują",
    desc: "Każdy doradca najpierw ocenia niezależnie (liczba przed uzasadnieniem), potem ścierają się ze sobą.",
  },
  {
    nr: "03",
    title: "Synteza + osie sporu",
    desc: "Dostajesz rekomendację razem z tym, o co panel wciąż się kłóci — bez udawanej jednomyślności.",
  },
];
---

<div class="bg-pixel-grid relative min-h-screen w-full bg-background">
  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero: character select -->
    <section class="animate-fade-up mx-auto flex max-w-5xl flex-col items-center px-4 pt-16 pb-12 text-center sm:pt-24">
      <h1 class="font-pixel mb-6 bg-gradient-to-r from-primary to-accent bg-clip-text text-2xl leading-relaxed text-transparent sm:text-4xl">
        PANEL EKSPERTÓW
      </h1>
      <p class="mb-12 max-w-2xl text-base text-muted-foreground sm:text-lg">Twój problem. Ich debata. Twoja decyzja.</p>

      <ul class="mb-12 grid w-full grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4" aria-label="Przykładowi doradcy">
        {advisors.map((advisor) => (
          <li class="pixel-panel flex flex-col items-center p-4 transition-transform duration-150 hover:border-accent motion-safe:hover:-translate-y-1 sm:p-5">
            <svg
              viewBox="0 0 12 12"
              shape-rendering="crispEdges"
              class="mb-4 h-16 w-16 sm:h-20 sm:w-20"
              aria-hidden="true"
            >
              {advisor.grid.flatMap((row, y) =>
                Array.from(row).map((px, x) =>
                  px === "." ? null : <rect x={x} y={y} width="1" height="1" style={`fill: ${PIXEL_FILL[px]}`} />,
                ),
              )}
            </svg>
            <h2 class="font-pixel mb-2 text-[0.65rem] text-foreground sm:text-xs">{advisor.name}</h2>
            <p class="mb-3 text-xs text-muted-foreground">{advisor.role}</p>
            <p class="mt-auto text-xs text-accent">
              <span aria-hidden="true">
                {"■".repeat(Math.round(advisor.score / 2))}
                {"□".repeat(5 - Math.round(advisor.score / 2))}
              </span>{" "}
              OCENA {advisor.score}/10
            </p>
          </li>
        ))}
      </ul>

      <div class="flex flex-col gap-5 sm:flex-row">
        <a
          href="/auth/signup"
          class="pixel-btn font-pixel bg-primary px-6 py-4 text-xs text-primary-foreground transition-colors hover:border-accent hover:bg-accent"
        >
          <span class="animate-blink" aria-hidden="true">
            ►
          </span>
          ZBIERZ SWÓJ PANEL
        </a>
        <a
          href="/auth/signin"
          class="pixel-btn font-pixel px-6 py-4 text-xs text-primary transition-colors hover:border-accent hover:text-accent"
        >
          ZALOGUJ SIĘ
        </a>
      </div>
    </section>

    <!-- How it works -->
    <section class="animate-fade-up mx-auto max-w-5xl px-4 pb-24">
      <h2 class="font-pixel mb-8 text-center text-sm text-accent sm:text-base">JAK TO DZIAŁA</h2>
      <ol class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {steps.map((step) => (
          <li class="pixel-panel p-6">
            <p class="font-pixel mb-4 text-lg text-accent" aria-hidden="true">
              {step.nr}
            </p>
            <h3 class="mb-2 font-bold text-foreground">{step.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{step.desc}</p>
          </li>
        ))}
      </ol>
    </section>
  </div>
</div>
