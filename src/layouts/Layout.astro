---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import { containerVariants } from "@/components/layout/container";
import { missingConfigs } from "@/lib/config-status";
import pixelFontLatin from "@/assets/fonts/silkscreen-latin-400.woff2?url";
import pixelFontLatinExt from "@/assets/fonts/silkscreen-latin-ext-400.woff2?url";

interface Props {
  title?: string;
}

const { title = "Panel Ekspertów" } = Astro.props;
---

<!doctype html>
<html lang="pl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href={pixelFontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pixelFontLatinExt} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-background">
    <div class={containerVariants({ width: "default" })}>
      <div class="pt-4 sm:pt-8">
        <Topbar />
      </div>
    </div>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
