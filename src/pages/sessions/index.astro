---
import Layout from "@/layouts/Layout.astro";
import SessionList from "@/components/session-history/SessionList.astro";
import { containerVariants } from "@/components/layout/container";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { headingVariants } from "@/components/ui/heading";
import { SessionRepository } from "@/lib/repositories/session.repository";
import { SessionService } from "@/lib/services/session.service";
import { createClient } from "@/lib/supabase";
import type { Session } from "@/types/session";

const client = createClient(Astro.request.headers, Astro.cookies);

let notConfigured = false;
let errorMessage: string | null = null;
let sessions: Session[] = [];

if (!client) {
  notConfigured = true;
} else {
  const service = new SessionService({ repository: new SessionRepository(client) });
  const result = await service.listSessions();
  if (result.ok) {
    sessions = result.value;
  } else {
    errorMessage = result.error.message;
  }
}
---

<Layout title="Historia sesji — Panel Ekspertów">
  <div class={`${containerVariants({ width: "default" })} flex flex-col pb-16 pt-12 sm:pt-16`}>
    <h1 class={`${headingVariants({ level: "page" })} mb-8 text-center`}>HISTORIA SESJI</h1>
    {
      notConfigured ? (
        <Alert variant="error" className="mx-auto max-w-xl">
          <AlertDescription>Usługa nie jest skonfigurowana. Spróbuj ponownie później.</AlertDescription>
        </Alert>
      ) : errorMessage ? (
        <Alert variant="error" className="mx-auto max-w-xl">
          <AlertDescription>Nie udało się wczytać historii sesji: {errorMessage}</AlertDescription>
        </Alert>
      ) : (
        <SessionList sessions={sessions} />
      )
    }
  </div>
</Layout>
