---
import Layout from "@/layouts/Layout.astro";
import { SessionFlow } from "@/components/advisor-panel/SessionFlow";
import { containerVariants } from "@/components/layout/container";
import { buttonVariants } from "@/components/ui/button";
import { headingVariants } from "@/components/ui/heading";
import { panelVariants } from "@/components/ui/panel";
import { ADVISOR_REGISTRY, MIN_ROUND_TWO_PARTICIPANTS } from "@/lib/advisors/registry";
import { SessionRepository } from "@/lib/repositories/session.repository";
import { createClient } from "@/lib/supabase";

const { id } = Astro.params;
const user = Astro.locals.user;
const sessionId = id ?? "";

let notFound = !id || !user;
let decision = "";
let context: string | null = null;
let hasRoundOne = false;
let hasRoundTwo = false;
let hasSynthesis = false;
let initialThreads: Record<string, { role: "user" | "advisor"; content: string }[]> = {};

if (id && user) {
  const client = createClient(Astro.request.headers, Astro.cookies);
  if (!client) {
    notFound = true;
  } else {
    const repository = new SessionRepository(client);
    const result = await repository.getSession(id);
    if (!result.ok || result.value?.userId !== user.id) {
      notFound = true;
    } else {
      decision = result.value.decision;
      context = result.value.context;

      const roundOneResult = await repository.getOpinions(id, 1);
      const roundOneRecords = roundOneResult.ok ? roundOneResult.value : [];
      hasRoundOne = roundOneRecords.length > 0;

      if (roundOneRecords.length >= MIN_ROUND_TWO_PARTICIPANTS) {
        const roundTwoResult = await repository.getOpinions(id, 2);
        hasRoundTwo = roundTwoResult.ok && roundTwoResult.value.length > 0;
      }

      const synthesisResult = await repository.getSynthesis(id);
      hasSynthesis = synthesisResult.ok && synthesisResult.value !== null;

      const sideThreadResult = await repository.getSideThreadMessagesForSession(id);
      if (sideThreadResult.ok) {
        for (const message of sideThreadResult.value) {
          const bucket = (initialThreads[message.personaId] ??= []);
          bucket.push({ role: message.role, content: message.content });
        }
      }
    }
  }
}

if (notFound) {
  Astro.response.status = 404;
}

const personas = ADVISOR_REGISTRY.map((persona) => ({ id: persona.id, label: persona.label }));
---

<Layout title="Panel doradców — Panel Ekspertów">
  <div class={`${containerVariants({ width: "wide" })} flex flex-col pb-16 pt-8 sm:pt-12`}>
    {notFound ? (
      <div class={`${panelVariants({ padding: "page" })} mx-auto max-w-xl text-center`}>
        <h1 class={headingVariants({ level: "page" })}>NIE ZNALEZIONO SESJI</h1>
        <p class="mb-6 mt-4 text-sm text-muted-foreground">Ta sesja nie istnieje albo nie masz do niej dostępu.</p>
        <a href="/sessions/new" class={buttonVariants({ variant: "default", size: "lg" })}>
          NOWA DECYZJA
        </a>
      </div>
    ) : (
      <>
        <div class={`${panelVariants({ padding: "page" })} mb-8`}>
          <h1 class={headingVariants({ level: "page" })}>TWOJA DECYZJA</h1>
          <p class="mt-4 text-sm leading-relaxed text-foreground">{decision}</p>
          {context && <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{context}</p>}
        </div>
        <SessionFlow
          sessionId={sessionId}
          personas={personas}
          minRoundTwoParticipants={MIN_ROUND_TWO_PARTICIPANTS}
          hasRoundOne={hasRoundOne}
          hasRoundTwo={hasRoundTwo}
          hasSynthesis={hasSynthesis}
          initialThreads={initialThreads}
          client:load
        />
      </>
    )}
  </div>
</Layout>
