---
import Layout from "@/layouts/Layout.astro";
import { DecisionForm } from "@/components/decision-form/DecisionForm";
import { containerVariants } from "@/components/layout/container";
import { headingVariants } from "@/components/ui/heading";
import { panelVariants } from "@/components/ui/panel";
---

<Layout title="Nowa decyzja — Panel Ekspertów">
  <div class={`${containerVariants({ width: "narrow" })} flex flex-col pb-16 pt-12 sm:pt-20`}>
    <h1 class={`${headingVariants({ level: "page" })} mb-8 text-center`}>NOWA DECYZJA</h1>
    <div class={panelVariants({ padding: "page" })}>
      <DecisionForm client:load />
    </div>
  </div>
</Layout>
