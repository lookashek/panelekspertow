---
import Layout from "@/layouts/Layout.astro";
import { containerVariants } from "@/components/layout/container";
import { buttonVariants } from "@/components/ui/button";
import { headingVariants } from "@/components/ui/heading";
import { panelVariants } from "@/components/ui/panel";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Rejestracja zakończona",
      description: "Twoje konto zostało utworzone. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź swoją skrzynkę e-mail",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Powrót do logowania",
    };
---

<Layout title={content.heading}>
  <div class={`${containerVariants({ width: "narrow" })} flex flex-1 flex-col items-center justify-center py-16`}>
    <div class={`${panelVariants({ padding: "page" })} w-full text-center`}>
      <div class="mb-4 text-5xl" aria-hidden="true">{content.emoji}</div>
      <h1 class={headingVariants({ level: "page" })}>{content.heading}</h1>
      <p class="mb-6 mt-4 text-muted-foreground">{content.description}</p>
      <a href="/auth/signin" class={buttonVariants({ variant: "link" })}>
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
