---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { containerVariants } from "@/components/layout/container";
import { buttonVariants } from "@/components/ui/button";
import { headingVariants } from "@/components/ui/heading";
import { panelVariants } from "@/components/ui/panel";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zaloguj się — Panel Ekspertów">
  <div class={`${containerVariants({ width: "narrow" })} flex flex-1 flex-col items-center justify-center py-16`}>
    <div class={`${panelVariants({ padding: "page" })} w-full`}>
      <h1 class={`${headingVariants({ level: "page" })} mb-6 text-center`}>ZALOGUJ SIĘ</h1>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Nie masz konta?{" "}
        <a href="/auth/signup" class={buttonVariants({ variant: "link" })}>
          Zarejestruj się
        </a>
      </p>
    </div>
  </div>
</Layout>
