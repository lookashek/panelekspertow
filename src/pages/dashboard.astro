---
import Layout from "@/layouts/Layout.astro";
import { containerVariants } from "@/components/layout/container";
import { buttonVariants } from "@/components/ui/button";
import { headingVariants } from "@/components/ui/heading";
import { panelVariants } from "@/components/ui/panel";

const { user } = Astro.locals;
---

<Layout title="Panel — Panel Ekspertów">
  <div class={`${containerVariants({ width: "narrow" })} flex flex-1 flex-col items-center justify-center py-16`}>
    <div class={`${panelVariants({ padding: "page" })} w-full text-center`}>
      <h1 class={headingVariants({ level: "page" })}>PANEL</h1>
      <p class="mt-4 text-muted-foreground">
        Witaj, <span class="font-bold text-foreground">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-muted-foreground">Ta strona jest dostępna tylko dla zalogowanych użytkowników.</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a href="/sessions/new" class={buttonVariants({ variant: "default", size: "lg" })}>
          NOWA DECYZJA
        </a>
        <a href="/sessions" class={buttonVariants({ variant: "secondary", size: "lg" })}>
          MOJE SESJE
        </a>
      </div>
    </div>
  </div>
</Layout>
